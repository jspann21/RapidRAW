{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "io.github.CyberTimon.RapidRAW",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RapidRAW",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' tauri: asset: https://asset.localhost data: blob: file: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://accounts.google.com https://oauth2.googleapis.com https://photoslibrary.googleapis.com https://raw.githubusercontent.com https://getrapidraw.com https://www.getrapidraw.com https://*.clerk.accounts.dev https://*.clerk.com; frame-src https://accounts.google.com https://www.openstreetmap.org https://*.clerk.accounts.dev https://*.clerk.com; object-src 'none'; base-uri 'none'; form-action 'self'",
      "capabilities": ["default"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources", "lensfun_db"],
    "category": "Photography",
    "fileAssociations": [
      {
        "ext": [
          "dng",
          "pro",
          "ari",
          "crw",
          "cr2",
          "cr3",
          "bay",
          "raw",
          "erf",
          "raf",
          "3fr",
          "fff",
          "iiq",
          "kdc",
          "k25",
          "dcs",
          "dcr",
          "mos",
          "rwl",
          "mef",
          "mrw",
          "nef",
          "nrw",
          "orf",
          "rw2",
          "pef",
          "ptx",
          "srw",
          "x3f",
          "arw",
          "srf",
          "sr2",
          "jpg",
          "jpeg",
          "png",
          "gif",
          "bmp",
          "tiff",
          "tif",
          "exr",
          "qoi"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "version": "1.5.6"
}
